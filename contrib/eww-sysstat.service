# Example user unit. Install:
#   cp contrib/eww-sysstat.service ~/.config/systemd/user/
#   systemctl --user enable --now eww-sysstat
# Adjust the paths if the config is not in ~/.config/eww-sysstat.
[Unit]
Description=eww-sysstat popup daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env eww -c %h/.config/eww-sysstat daemon --no-daemonize
# User services start with a minimal PATH; the poll scripts need python3 and
# the Task Manager button needs your desktop's binaries.
Environment=PATH=%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
