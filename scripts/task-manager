#!/usr/bin/env python3
"""Launch the configured task manager, detached from eww.

Setting: SYSSTAT_TASK_MANAGER (default: first of xfce4-taskmanager,
gnome-system-monitor, plasma-systemmonitor, missioncenter found on PATH).
"""
import shlex
import shutil
import subprocess

import sysstat_env

command = sysstat_env.get(sysstat_env.load(), "SYSSTAT_TASK_MANAGER")
if command:
    argv = shlex.split(command)
else:
    found = next((c for c in ("xfce4-taskmanager", "gnome-system-monitor", "plasma-systemmonitor", "missioncenter") if shutil.which(c)), None)
    argv = [found] if found else []

if argv:
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
