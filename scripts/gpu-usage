#!/usr/bin/env python3
"""GPU utilisation, VRAM usage and temperature as one JSON object.

Reads amdgpu sysfs; falls back to nvidia-smi when no amdgpu card is found.
Settings:
  SYSSTAT_GPU   DRM card name (e.g. card1) or nvidia GPU index. Default: the
                card with the most VRAM, i.e. the discrete GPU.
"""
import json
import subprocess
from pathlib import Path

import sysstat_env

settings = sysstat_env.load()
EMPTY = {"present": False, "name": "", "util": 0, "temp": "", "vram_used": 0, "vram_total": 0, "vram_percent": 0}


def read_int(path: Path) -> int | None:
    try:
        return int(path.read_text())
    except (OSError, ValueError):
        return None


def amd_temp(dev: Path) -> str:
    for hwmon in sorted((dev / "hwmon").glob("hwmon*")):
        milli = read_int(hwmon / "temp1_input")
        if milli is not None:
            return f"{round(milli / 1000)}°C"
    return ""



def amdgpu() -> dict | None:
    wanted = sysstat_env.get(settings, "SYSSTAT_GPU")
    best = None
    for card in sorted(Path("/sys/class/drm").glob("card[0-9]*")):
        if "-" in card.name or (wanted and card.name != wanted):
            continue
        dev = card / "device"
        busy = read_int(dev / "gpu_busy_percent")
        total = read_int(dev / "mem_info_vram_total")
        used = read_int(dev / "mem_info_vram_used")
        if busy is None or not total or used is None:
            continue
        if best is None or total > best["vram_total"]:
            best = {"present": True, "name": card.name, "util": busy, "temp": amd_temp(dev),
                    "vram_used": used, "vram_total": total, "vram_percent": 100 * used / total}
    return best


def nvidia() -> dict | None:
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=3, check=True).stdout
        rows = [[f.strip() for f in line.split(",")] for line in out.splitlines() if line.strip()]
        wanted = sysstat_env.get(settings, "SYSSTAT_GPU", "0")
        name, util, used, total, temp = rows[int(wanted)]
        used, total = int(used) * 1048576, int(total) * 1048576
        return {"present": True, "name": name, "util": int(util), "temp": f"{temp}°C",
                "vram_used": used, "vram_total": total, "vram_percent": 100 * used / total}
    except (OSError, subprocess.SubprocessError, ValueError, IndexError, ZeroDivisionError):
        return None


print(json.dumps(amdgpu() or nvidia() or EMPTY))
