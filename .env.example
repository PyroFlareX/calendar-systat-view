# Copy to .env next to eww.yuck (or point $EWW_SYSSTAT_ENV at another file).
# The file is parsed, never executed. Real environment variables override it.
# Every setting is optional.

# ── LLM quota card ──────────────────────────────────────────────────
# Leave LLM_USAGE_URL empty to hide the card entirely.
LLM_USAGE_URL=
# e.g. LLM_USAGE_URL=https://llm-gateway.example.com/v1/usage

# Bearer token. Prefer LLM_USAGE_TOKEN_FILE so the secret lives in a 0600 file.
LLM_USAGE_TOKEN=
LLM_USAGE_TOKEN_FILE=
# e.g. LLM_USAGE_TOKEN_FILE=~/.config/eww-sysstat/token

LLM_USAGE_TIMEOUT=5

# Display names for provider ids reported by the endpoint.
LLM_USAGE_PROVIDERS=anthropic=Claude,openai-codex=Codex

# Render from a saved JSON payload instead of HTTP (demos, offline styling).
# LLM_USAGE_FIXTURE=./docs/fixtures/usage.json
LLM_USAGE_FIXTURE=

# ── System card ─────────────────────────────────────────────────────
# Header label; empty uses the machine hostname.
SYSSTAT_HOSTNAME=
# Filesystem for the disk ring.
SYSSTAT_DISK_PATH=/
# hwmon driver for CPU temperature (k10temp, coretemp, zenpower, cpu_thermal).
SYSSTAT_CPU_SENSOR=
# power_supply device; empty picks the first BAT*. No battery hides the ring.
SYSSTAT_BATTERY=
# Command for the Task Manager button; empty picks the first one installed.
SYSSTAT_TASK_MANAGER=

# ── Placement (used by ./sysstat-toggle) ────────────────────────────
SYSSTAT_ANCHOR=bottom right
SYSSTAT_X=-10px
SYSSTAT_Y=-44px
# EWW_BIN=eww
